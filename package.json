{
  "name": "graphbrain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test apps packages",
    "dev:api": "bun run --filter @graphbrain/api dev",
    "dev:dashboard": "bun run --filter @graphbrain/dashboard dev",
    "dev:marketing": "bun run --filter @graphbrain/marketing dev"
  },
  "devDependencies": {
    "bun-types": "^1.3.0",
    "typescript": "^5.6.0"
  }
}
