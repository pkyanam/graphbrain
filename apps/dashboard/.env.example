# Graphbrain dashboard — environment variables.
#
# Copy to .env.local and fill in. These are read by Next.js at build/dev time.

# Clerk publishable key (exposed to the browser — safe to expose).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# The Graphbrain API service base URL.
# Dev:  http://localhost:3000
# Prod: https://api.graphbrain.belweave.ai
NEXT_PUBLIC_API_URL=http://localhost:3000

# Clerk secret key (server-side only — NOT exposed to the browser).
# Used by auth() to mint the session JWT for server-side API calls.
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs (optional — defaults below match the dev routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
