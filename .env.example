# Graphbrain — environment variables
# Copy to `.env` and fill in real values. See IMPLEMENTATION.md "Prerequisites".

# ─── Clerk ───────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER=
CLERK_WEBHOOK_SECRET=

# ─── Coolify ─────────────────────────────────────────────────────────────────
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_SERVER_UUID=

# ─── OpenRouter ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ─── Encryption (AES-256-GCM, 32 bytes base64) ───────────────────────────────
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── Polygres (local dev — set by docker-compose) ────────────────────────────
# postgres://graphbrain:graphbrain@localhost:5432/graphbrain_control
POLYGRES_DATABASE_URL=postgres://graphbrain:graphbrain@localhost:5432/graphbrain_control

# ─── MinIO (local dev — set by docker-compose) ───────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=graphbrain
MINIO_SECRET_KEY=graphbrain-dev-secret

# ─── HelixDB (local dev — set by docker-compose) ─────────────────────────────
HELIX_INSTANCE_URL=http://localhost:8080
HELIX_API_KEY=dev-key
